# Gateway Settings
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_TIMEOUT_SEC=5.0

# Hardware Serial Ports Configuration
COM_PORT_N1=COM3
BAUD_RATE_N1=115200

COM_PORT_N2=COM4
BAUD_RATE_N2=115200

COM_PORT_N3=COM5
BAUD_RATE_N3=9600

COM_PORT_N4=COM6
BAUD_RATE_N4=115200

# ZeroClaw & LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Benchmark Runner Modes (real | mock)
HARDWARE_MODE=real
LOG_LEVEL=INFO
